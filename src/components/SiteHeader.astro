---
import Button from './Button.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <nav class="nav" aria-label="Основная навигация">
      <details class="nav__dropdown">
        <summary class="nav__link nav__summary">
          О проекте
          <img
            class="nav__chevron"
            src="/icons/icon-chevron.svg"
            alt=""
            width="14"
            height="14"
          />
        </summary>
        <ul class="nav__menu">
          <li><a href="/method.html">Метод Syntonia</a></li>
          <li><a href="/masters.html">Мастера</a></li>
        </ul>
      </details>
      <a class="nav__link" href="/quiz.html">Понять себя</a>
      <a class="nav__link" href="/practice.html">Пространство практики</a>
    </nav>

    <a class="logo" href="/index.html" aria-label="Syntonia — на главную">
      <img
        src="/icons/logo-gold.svg"
        alt="Syntonia — Evolution of Consciousness"
        width="168"
        height="60"
      />
    </a>

    <div class="actions">
      <div class="actions__cta">
        <Button
          href="/booking.html"
          label="Личная встреча"
          variant="textured"
          caps
          class="btn--header"
        />
      </div>
      <a class="login" href="#" aria-label="Личный кабинет (скоро)">
        <img src="/icons/icon-profile.svg" alt="" width="45" height="45" />
      </a>
      <button
        class="burger"
        type="button"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 8px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .site-header__inner {
    width: min(1424px, calc(100% - 16px));
    height: 92px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-radius: var(--radius-header);
    background: var(--color-header);
    box-shadow: inset 0 0 0 0.5px rgba(138, 133, 96, 0.9);
    pointer-events: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav__link {
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
    white-space: nowrap;
  }

  .nav__dropdown {
    position: relative;
  }

  .nav__summary {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    cursor: pointer;
  }

  .nav__summary::-webkit-details-marker {
    display: none;
  }

  .nav__chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .nav__dropdown[open] .nav__chevron {
    transform: rotate(180deg);
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 14px);
    left: -12px;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border-radius: 12px;
    background: rgba(58, 51, 35, 0.98);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  .nav__menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--color-white);
    font-size: 17px;
    line-height: 1.4;
  }

  .nav__menu a:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .logo {
    justify-self: center;
    display: block;
    width: 168px;
    height: 60px;
  }

  .logo img {
    width: 100%;
    height: 100%;
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .actions__cta {
    margin-right: -8px;
  }

  .login {
    display: block;
    width: 45px;
    height: 45px;
    border-radius: var(--radius-btn);
  }

  .login img {
    width: 45px;
    height: 45px;
  }

  .burger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 38px;
    height: 25px;
  }

  .burger span {
    display: block;
    width: 38px;
    height: 3px;
    border-radius: 4px;
    background: var(--color-white);
  }

  @media (max-width: 1320px) {
    .nav {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .logo {
      justify-self: start;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      top: 6px;
    }

    .site-header__inner {
      width: calc(100% - 12px);
      height: 72px;
      padding: 0 16px;
    }

    .logo {
      width: 150px;
      height: 54px;
    }

    .login {
      display: none;
    }

    .burger {
      width: 32px;
      height: 21px;
    }

    .burger span {
      width: 32px;
    }
  }
</style>
